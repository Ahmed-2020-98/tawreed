    "@tawreed/mobile": "workspace:*",
    "@tawreed/tokens": "workspace:*",
    "expo": "~57.0.25",
    "expo-constants": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
