{
  "name": "@tawreed/api",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "description": "Tawreed REST API + workers (NestJS 12, Prisma 7, PostgreSQL, Redis/BullMQ, Socket.IO)",
  "type": "module",
  "scripts": {
    "dev": "nest start --watch --preserveWatchOutput",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed/index.ts && nest build && node dist/seed/demo-activity.js",
    "db:reset": "prisma migrate reset --force --skip-seed && pnpm db:seed",
    "seed:media": "tsx prisma/seed/media/fetch-media.ts",
    "postinstall": "prisma generate || true",
    "db:seed:base": "tsx prisma/seed/index.ts",
    "db:seed:demo": "nest build && node dist/seed/demo-activity.js"
  },
  "dependencies": {
    "@date-fns/tz": "^1.4.1",
    "@expo-google-fonts/cairo": "^0.4.2",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.1.0",
    "@nestjs/core": "^12.1.0",
    "@nestjs/platform-express": "^12.1.0",
    "@nestjs/platform-socket.io": "^12.1.0",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/websockets": "^12.1.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@sparticuz/chromium": "^153.0.0",
    "@tawreed/contracts": "workspace:*",
    "@tawreed/i18n": "workspace:*",
    "@vercel/blob": "^2.8.0",
    "@vercel/functions": "^3.9.9",
    "argon2": "^0.45.1",
    "bullmq": "^6.3.9",
    "date-fns": "^4.1.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.3",
    "expo-server-sdk": "^7.2.0",
    "express": "^5.1.0",
    "file-type": "^21.1.0",
    "handlebars": "^4.7.8",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.2",
    "jose": "^6.2.12",
    "nodemailer": "^7.0.10",
    "pg": "^8.16.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "playwright-core": "^1.63.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.7",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.1.0",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.2",
    "@tawreed/eslint-config": "workspace:*",
    "@tawreed/tsconfig": "workspace:*",
    "@types/express": "^5.0.5",
    "@types/multer": "^2.0.0",
    "@types/nodemailer": "^7.0.3",
    "@types/pg": "^8.15.6",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.1",
    "pino-pretty": "^13.1.2",
    "prisma": "7.10.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "6.0.3",
    "unplugin-swc": "^1.6.0",
    "vitest": "^4.1.2"
  }
}
