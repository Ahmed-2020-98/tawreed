<!doctype html>
<html lang="{{locale}}" dir="{{dir}}">
<head>
<meta charset="utf-8" />
<title>{{title}}</title>
<style>
{{{fontCss}}}
* { box-sizing: border-box; }
body { font-family: 'Cairo', 'Segoe UI', Tahoma, sans-serif; color: #0E1A2E; font-size: 11.5px; margin: 0; }
.header { display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 3px solid #0A9B69; padding-bottom: 14px; margin-bottom: 16px; }
.brand img { height: 58px; }
.doc-title { text-align: end; }
.doc-title h1 { margin: 0; font-size: 20px; color: #0B2D5B; font-weight: 800; }
.doc-title .sub { color: #6B7787; font-size: 11px; }
.badge { display: inline-block; padding: 2px 10px; border-radius: 999px; background: #E9F8F2; color: #067A5B; font-weight: 700; font-size: 10.5px; margin-top: 4px; }
.grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 14px; }
.card { border: 1px solid #DDE2E8; border-radius: 10px; padding: 10px 12px; background: #FBFCFD; }
.card h3 { margin: 0 0 6px; font-size: 11px; color: #067A5B; text-transform: uppercase; letter-spacing: .3px; }
.row { display: flex; justify-content: space-between; gap: 8px; padding: 1.5px 0; }
.row .k { color: #6B7787; }
.row .v { font-weight: 600; text-align: end; }
table { width: 100%; border-collapse: collapse; margin-top: 4px; }
th { background: #0B2D5B; color: #fff; font-weight: 700; font-size: 10.5px; padding: 7px 6px; text-align: start; }
td { border-bottom: 1px solid #EBEEF2; padding: 7px 6px; vertical-align: top; }
td.num, th.num { text-align: end; white-space: nowrap; font-variant-numeric: tabular-nums; }
tr:nth-child(even) td { background: #F9FAFB; }
.totals { width: 46%; margin-inline-start: auto; margin-top: 12px; }
.totals .row { padding: 4px 0; border-bottom: 1px dashed #DDE2E8; }
.totals .grand { font-size: 14px; color: #0B2D5B; font-weight: 800; border-bottom: none; border-top: 2px solid #0B2D5B; padding-top: 7px; }
.footer { margin-top: 22px; display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; }
.qr img { width: 118px; height: 118px; }
.note { color: #6B7787; font-size: 10px; line-height: 1.7; }
.sign { display: flex; gap: 40px; margin-top: 26px; }
.sign div { flex: 1; border-top: 1px solid #98A3B1; padding-top: 6px; color: #515C6B; text-align: center; }
</style>
</head>
<body>
<div class="header">
  <div class="brand"><img src="{{logo}}" alt="Tawreed" /></div>
  <div class="doc-title">
    <h1>{{title}}</h1>
    {{#if titleAlt}}<div class="sub">{{titleAlt}}</div>{{/if}}
    <div class="sub">{{numberLabel}}: <b>{{number}}</b> · {{dateLabel}}: {{date}}</div>
    {{#if badge}}<div class="badge">{{badge}}</div>{{/if}}
  </div>
</div>
{{> body}}
</body>
</html>
