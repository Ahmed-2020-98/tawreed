{
  "expo": {
    "name": "توريد موردين",
    "slug": "tawreed-supplier",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tawreed-supplier",
    "userInterfaceStyle": "light",
    "primaryColor": "#0B2D5B",
    "ios": {
      "bundleIdentifier": "sa.tawreed.supplier",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleDevelopmentRegion": "ar",
        "NSPhotoLibraryUsageDescription": "لرفع صور المنتجات والمستندات.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "sa.tawreed.supplier",
      "adaptiveIcon": {
        "backgroundColor": "#0B2D5B",
        "foregroundImage": "./assets/images/adaptive-foreground.png"
      },
      "permissions": [],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-localization",
        {
          "supportsRTL": true
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B2D5B",
          "image": "./assets/images/splash.png",
          "imageWidth": 160
        }
      ]
    ],
    "extra": {
      "appClient": "SUPPLIER_APP",
      "supportsRTL": true,
      "router": {},
      "eas": {
        "projectId": "7a9e0532-ef3f-4e88-84a7-b705c4a75ecd"
      }
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "ahmedgamalmansour11sa"
  }
}
