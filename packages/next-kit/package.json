{
  "name": "@tawreed/next-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Next.js plumbing: BFF auth cookies, API proxy, i18n and providers",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
