  },
  "devDependencies": {
    "@tawreed/eslint-config": "workspace:*",
    "@tawreed/tsconfig": "workspace:*",
    "eslint": "^9.39.1",
    "typescript": "6.0.3",
    "vitest": "^4.1.2",
    "next": "16.3.6",
    "@types/react": "^19.2.2"
  }
